{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "ruby \"${ZCODE_PROJECT_DIR}/.zcode/hooks/guard.rb\"",
              "timeoutMs": 10000,
              "statusMessage": "铁律守卫检查"
            }
          ]
        },
        {
          "matcher": "Edit|Write|MultiEdit|NotebookEdit",
          "hooks": [
            {
              "type": "command",
              "command": "ruby \"${ZCODE_PROJECT_DIR}/.zcode/hooks/guard.rb\"",
              "timeoutMs": 10000,
              "statusMessage": "铁律守卫检查"
            }
          ]
        }
      ]
    }
  }
}
